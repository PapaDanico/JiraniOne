# ─── Database — Supabase PostgreSQL ───────────────────────────────────────────
# Use the "Transaction pooler" connection string from Supabase's Connect
# dialog (Project Settings > Database), not the direct connection — the app
# runs as a Netlify Function, and pooling avoids exhausting Postgres's
# connection limit under concurrent invocations.
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:6543/postgres

# ─── Session ──────────────────────────────────────────────────────────────────
SESSION_SECRET=long_random_string_minimum_32_characters_here

# ─── M-PESA Daraja API (sandbox: developer.safaricom.co.ke) ──────────────────
MPESA_CONSUMER_KEY=your_daraja_consumer_key
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret
MPESA_SHORTCODE=your_paybill_or_till_number
MPESA_PASSKEY=your_lipa_na_mpesa_passkey
# Production: https://www.jiranihub.co.ke/api/payments/mpesa/callback
# Dev: use ngrok — e.g. https://abc123.ngrok.io/api/payments/mpesa/callback
MPESA_CALLBACK_URL=https://www.jiranihub.co.ke/api/payments/mpesa/callback

# ─── SMS — Africa's Talking (africastalking.com) ─────────────────────────────
SMS_API_KEY=your_africastalking_api_key
SMS_USERNAME=your_africastalking_username
# SMS_PROVIDER=africastalking  # default

# ─── Server ───────────────────────────────────────────────────────────────────
# ─── Optional integrations ────────────────────────────────────────────────────
# Google Maps Distance Matrix API — enables live Mombasa Road travel times
# Get free key at console.cloud.google.com (2500 free requests/day)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_optional

NODE_ENV=development
PORT=5000
CLIENT_URL=https://www.jiranihub.co.ke   # only used in production CORS

# ─── Platform-owner-only views ────────────────────────────────────────────────
# PLATFORM_OWNER_PHONE: gates GET /api/system/error-logs (server error log
# viewer at /admin/system/error-logs). Must match the phone on the owner's
# own user account exactly (+254 format). Unset = nobody gets in, not
# everybody — leave unset in any environment where this view shouldn't exist.
# PLATFORM_OWNER_PHONE=+254700000000

# ─── Tester demo accounts (optional) ─────────────────────────────────────────
# DEMO_PASSWORD: when set, `npm run db:seed` gives all four seed accounts
# the same password. Share with testers out-of-band. Must be ≥ 8 chars.
# DEMO_PASSWORD=
#
# VITE_DEMO_MODE: set to "1" at build-time to surface a "Demo accounts"
# panel on the sign-in page. The four phone numbers are bundled, the
# password never is. Leave unset for production.
# VITE_DEMO_MODE=1

# ─── Web Push (VAPID) ─────────────────────────────────────────────────────────
# Generate once with: npx web-push generate-vapid-keys
# Unset = push disabled entirely (opt-in toggle hidden, sends no-op).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# ─── WhatsApp channel (Africa's Talking Chat API) ────────────────────────────
# OFF by default. Flip WHATSAPP_ENABLED=true only after Meta Business
# verification completes and the sender number is approved in the AT
# dashboard. Uses the same SMS_API_KEY/SMS_USERNAME credentials; falls
# back to SMS automatically on any WhatsApp failure.
# WHATSAPP_ENABLED=false
# WHATSAPP_SENDER_NUMBER=+254700000000

# ─── SMS sender ID (Africa's Talking) ────────────────────────────────────────
# Leave UNSET until the alphanumeric sender ID is registered AND approved in
# the Africa's Talking dashboard — AT silently drops messages from
# unapproved sender IDs (still returns HTTP 201). Unset = AT's shared
# default shortcode, which always delivers.
# SMS_REGISTERED_SENDER_ID=JiraniOne
